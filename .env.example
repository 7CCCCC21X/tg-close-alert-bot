# Do not commit a real token. Set these in Railway -> Variables.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# 0 means setup-only. Send /id to the running bot, then replace 0 with your user ID.
ADMIN_USER_ID=0
SYMBOLS=UNITREEUSDT,HK0625USDT,CXMTUSDT,SKHYNIXUSDT
# 1 means 1%, not 0.01. Equality does NOT trigger.
ALERT_THRESHOLD_PCT=1
POLL_SECONDS=5
ALERT_COOLDOWN_SECONDS=300
# 1 means another alert at each additional percentage-point band.
# 0 disables expansion alerts. A 30-second minimum gap still applies.
ALERT_STEP_PCT=1
MIN_ALERT_GAP_SECONDS=30
MAX_PRICE_AGE_SECONDS=120
# binance_daily = previous completed Binance UTC daily close, NOT stock official close.
# manual = user supplied, same-quote-unit reference, valid for one Beijing calendar day.
BASELINE_MODE=binance_daily
# Requires a Railway Volume mounted at /data for persistence.
STATE_DB=/data/bot.sqlite3
