# Do not commit a real token. Set these in Railway -> Variables.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# 0 means setup-only. Send /id to the running bot, then replace 0 with your user ID.
ADMIN_USER_ID=0
SYMBOLS=UNITREEUSDT,HK0625USDT,CXMTUSDT,SKHYNIXUSDT
# 1 means 1%, not 0.01. Equality does NOT trigger.
ALERT_THRESHOLD_PCT=1
POLL_SECONDS=5
# Realtime stock quotes while a stock's session runs (3-300 s). Indices are fixed: SSE/A50 and KOSPI every 10 s in
# session, HSI 20 s, 60 s when shut.
QUOTE_REFRESH_SECONDS=5
ALERT_COOLDOWN_SECONDS=300
# 1 means another alert at each additional percentage-point band.
# 0 disables expansion alerts. A 30-second minimum gap still applies.
ALERT_STEP_PCT=1
MIN_ALERT_GAP_SECONDS=30
MAX_PRICE_AGE_SECONDS=120
# binance_daily = previous completed Binance UTC daily close, NOT stock official close.
# exchange_close = Binance contract price at the underlying exchange's latest close (same instant as the exchange close).
# manual = user supplied, same-quote-unit reference, valid for one Beijing calendar day.
BASELINE_MODE=exchange_close
# Requires a Railway Volume mounted at /data for persistence.
STATE_DB=/data/bot.sqlite3
# Underlying stock of each contract, for the automatic "证券交易所收盘价" line (read-only public daily bars).
# Format: SYMBOL=market:code[:same]; markets sh/sz (Eastmoney A-share), hk (Eastmoney HKEX), kr (Naver KRX).
# Append :same when the contract is quoted in the stock's own currency so a deviation is computed. off disables.
EXCHANGE_TICKERS=UNITREEUSDT=sh:688836,HK0625USDT=hk:00625:same,CXMTUSDT=sh:688825,SKHYNIXUSDT=kr:000660
# Optional: FX overrides (units per 1 USD) used to convert exchange closes; otherwise fetched from Frankfurter/ECB.
# FX_RATES=CNY=7.12,HKD=7.79,KRW=1390
# cn = 红涨绿跌 (default), us = 绿涨红跌
COLOR_STYLE=cn
# Hang Seng Index futures quote (incl. 17:15-03:00 after-hours) in /status and HK alerts; off disables.
HSI_FUTURES=on
# Hyperliquid reference markets: SYMBOL=dex:COIN (HIP-3 dex such as xyz; omit dex: for the main perp dex). off disables.
HL_TICKERS=UNITREEUSDT=xyz:UNITREE,HK0625USDT=xyz:SHEIN,CXMTUSDT=xyz:CXMT,SKHYNIXUSDT=xyz:SKHX
# KOSPI composite index in /status and Korea alerts; off disables.
KOSPI_INDEX=on
# Hyperliquid index perps compared with the cash index (KR200 = KOSPI 200); off disables.
HL_INDEX=KR200=xyz:KR200
# Close-direction probabilities in /status and /prob; off disables. PROB_VOL overrides daily σ in percent.
PROBABILITY=on
# PROB_VOL=UNITREEUSDT=3.5,HSI=1.2,KOSPI=2
# Shanghai Composite with FTSE China A50 futures as after-hours proxy; A50_BETA maps A50 moves to the Composite.
SSE_INDEX=on
A50_BETA=0.8
# KOSPI move per unit of HL KR200 move after hours (default 1); check /calib before changing it.
# KOSPI_BETA=1
# Weekday exchange holidays (target dates skip them); ranges allowed. Only certain dates: add the 2027 Lunar New Year
# closures once the exchanges publish them. /status and the startup log warn 30 days before the table runs out.
HOLIDAYS_CN=2026-09-25,2026-10-01..2026-10-07,2027-01-01
HOLIDAYS_KR=2026-09-24,2026-09-25,2026-10-05,2026-10-09,2026-12-25,2026-12-31,2027-01-01
HOLIDAYS_HK=2026-10-01,2026-12-25,2027-01-01
# Days with a different session: HKEX half days (close 12:10, HSI futures 12:30, no night session) and KRX days that run
# one hour late (the CSAT day: 10:00–16:30). Comma-separated dates; empty = none.
HK_HALF_DAYS=2026-12-24,2026-12-31,2027-02-05
KR_LATE_DAYS=2026-11-19
# SGX (the A50 futures): no session on a Singapore holiday; a half day trades the morning only (to 12:00, no T+1 session).
HOLIDAYS_SG=2026-01-01,2026-02-17,2026-02-18,2026-04-03,2026-05-01,2026-05-27,2026-06-01,2026-08-10,2026-11-09,2026-12-25,2027-01-01
SG_HALF_DAYS=2026-02-16,2026-12-24,2026-12-31
# Predict.fun daily up/down orderbooks compared with the model (/book, /prob, web page); off disables.
PREDICT=on
# Optional API key for api.predict.fun (sent as x-api-key); set it if /book shows HTTP 401/403.
# PREDICT_API_KEY=
# PREDICT_POLL_SECONDS=15
# Referral code appended to Predict market links (?ref=); empty = none.
# PREDICT_REF_CODE=B00EA
# Edges are net: takers pay fee x min(p, 1-p) (the market's own feeRateBps, else PREDICT_FEE_BPS) and walk the book for
# PREDICT_TRADE_USD; a suggestion needs PREDICT_MIN_EDGE_CENTS or the model's own error, whichever is larger.
# PREDICT_FEE_BPS=200
# PREDICT_TRADE_USD=100
# PREDICT_MIN_EDGE_CENTS=2
# Telegram edge alerts to subscribed chats: a suggestion reaching EDGE_ALERT_CENTS (new), the announced side no longer
# suggested (gone) or the other side suggested instead (flip); each change must hold EDGE_ALERT_CONFIRM_SECONDS, and the
# same market and side is announced as new again only after EDGE_ALERT_COOLDOWN_SECONDS. EDGE_ALERT=off disables.
# EDGE_ALERT=on
# EDGE_ALERT_CENTS=10
# EDGE_ALERT_CONFIRM_SECONDS=60
# EDGE_ALERT_COOLDOWN_SECONDS=900
# Slug stem per item; the date part (-up-or-down-on-september-28-2026) follows the model's target close.
# PREDICT_SLUGS=HSI=hang-seng-index,KOSPI=kospi-composite-index,SSE=sse-composite-index,UNITREEUSDT=unitree,HK0625USDT=shein,CXMTUSDT=cxmt,SKHYNIXUSDT=sk-hynix-inc
# Read-only probability web page. Railway injects PORT and RAILWAY_PUBLIC_DOMAIN once a domain is generated.
# WEB=off disables; WEB_PORT / WEB_BASE_URL for other hosts; WEB_TOKEN pins the secret path (16-64 chars).
# WEB_TOKEN=

# A US stock "hits $X by <date>" card (STRC 触及 $100) reads its deadline from the Predict title; pin it by hand as
# <STOCK_HIT_MARKETS key>=<YYYY-MM-DD> (23:59 ET of that day) when the title cannot be read. Several: separate with ;
# LADDER_DEADLINES=STRC-100=2026-12-31
